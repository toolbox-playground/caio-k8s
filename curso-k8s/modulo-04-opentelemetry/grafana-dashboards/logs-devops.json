{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "logs", "name": "Logs", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Dashboard DevOps — saúde da aplicação derivada exclusivamente dos logs via Loki LogQL. Latência por unwrap, atividade por endpoint, eventos de negócio e diagnóstico ao vivo.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Saúde da Aplicação",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Total de linhas de log na última hora. Um valor baixo ou zero indica crash silencioso — a aplicação parou de emitir logs sem lançar erro explícito. Verde acima de 10, vermelho abaixo de 1.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 10 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Total de Logs (1h) — sinal de vida",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({service_name=\"ranking-api\"}[1h]))",
          "legendFormat": "Total",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Percentual de logs ERROR na última hora. Acima de 5% indica degradação real. Acima de 15% indica falha crítica em andamento.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Taxa de Logs ERROR (%)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({service_name=\"ranking-api\", level=\"ERROR\"}[1h])) / sum(count_over_time({service_name=\"ranking-api\"}[1h])) * 100",
          "legendFormat": "ERROR %",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Latência média calculada a partir do campo duration_ms embutido nos logs — sem precisar consultar o Prometheus. Usa LogQL unwrap para extrair o valor numérico do body JSON de cada linha de log.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "orange", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Latência Média via Logs (unwrap duration_ms)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "avg(avg_over_time({service_name=\"ranking-api\", exporter=\"OTLP\"} | json | attributes_duration_ms > 0 | unwrap attributes_duration_ms [1h]))",
          "legendFormat": "avg ms",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 5,
      "title": "Volume de Logs — Indicador de Saúde Geral",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Volume de logs empilhado por nível ao longo do tempo. INFO (verde) = atividade normal. WARN crescente antes de ERROR = degradação progressiva. Queda súbita em INFO = possível crash silencioso ou perda de tráfego.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ERROR" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "WARN" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "INFO" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Volume por Nível (empilhado) — INFO / WARN / ERROR",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({service_name=\"ranking-api\"}[$__interval])) by (level)",
          "legendFormat": "{{level}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Somente anomalias (ERROR e WARN). Use para detectar o padrão de degradação progressiva: WARN sobe primeiro, depois ERROR aparece. Um pico isolado de ERROR sem WARN anterior indica erro pontual (exceção esperada). WARN seguido de ERROR indica problema sistêmico.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ERROR" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "WARN" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 7,
      "options": {
        "legend": {
          "calcs": ["sum", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Anomalias — ERROR e WARN (padrão de degradação)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({service_name=\"ranking-api\", level=~\"ERROR|WARN\"}[$__interval])) by (level)",
          "legendFormat": "{{level}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 8,
      "title": "Endpoints — Atividade e Latência Derivada dos Logs (sem Prometheus)",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Quantidade de logs emitidos por endpoint (campo endpoint extraído do body JSON via | json). Uma linha que some indica que o endpoint parou de ser chamado ou parou de logar. Detecta queda de tráfego por rota.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 9,
      "options": {
        "legend": {
          "calcs": ["sum", "mean"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Atividade por Endpoint (extraída do campo endpoint nos logs)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({service_name=\"ranking-api\", exporter=\"OTLP\"} | json | body =~ \"Consultando rankings|Score submetido|Opera\u00e7\u00e3o lenta conclu\u00edda\" [$__interval])) by (body)",
          "legendFormat": "{{body}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Latência média por endpoint derivada exclusivamente dos logs usando `unwrap duration_ms`. O campo duration_ms é emitido nos logs de encerramento de cada request. Sem Prometheus, sem histogram — só os logs estruturados.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 10,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Latência Média por Endpoint — unwrap duration_ms (sem Prometheus)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "avg by (body) (avg_over_time({service_name=\"ranking-api\", exporter=\"OTLP\"} | json | attributes_duration_ms > 0 | unwrap attributes_duration_ms [$__interval]))",
          "legendFormat": "{{body}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 11,
      "title": "Eventos de Negócio — Derivados dos Logs",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Scores enviados (total) vs novos recordes (score superou o máximo anterior). A linha de recordes deve ser sempre menor ou igual à de envios. Um ratio baixo de recordes/envios indica que os jogadores estão estagnando — insight de produto diretamente dos logs.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Scores enviados" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Novos recordes" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 12,
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Scores Enviados vs Novos Recordes",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({service_name=\"ranking-api\", exporter=\"OTLP\"} |= \"Score submetido\" [$__interval]))",
          "legendFormat": "Scores enviados",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({service_name=\"ranking-api\", exporter=\"OTLP\"} | json | attributes_new_record = \"true\" [$__interval]))",
          "legendFormat": "Novos recordes",
          "queryType": "range",
          "refId": "B"
        }
      ]
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Top 5 jogadores por volume de logs emitidos (campo player extraído do JSON). Um player com muito mais atividade que os outros pode indicar uso automatizado. Cruze com o painel de abuso no dashboard DevSecOps para confirmar.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 13,
      "options": {
        "legend": {
          "calcs": ["sum", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Top 5 Players Mais Ativos (via logs)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "topk(5, sum(count_over_time({service_name=\"ranking-api\", exporter=\"OTLP\"} | json | attributes_player != \"\" [$__interval])) by (attributes_player))",
          "legendFormat": "{{attributes_player}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 14,
      "title": "Diagnóstico — Logs ao Vivo",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Stream de WARN e ERROR em tempo real. Clique em uma linha para expandir o JSON e ver os campos extras (player, score, endpoint) e o traceID. Use o traceID para ir direto ao waterfall no Tempo.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "id": 15,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "Logs WARN e ERROR — expandir para ver traceID",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{service_name=\"ranking-api\", level=~\"WARN|ERROR\"}",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Logs de requisições que levaram mais de 150ms — filtrados via | json | duration_ms > 150. Útil para identificar operações lentas sem abrir o Tempo. O body JSON mostra o endpoint e a duração exata.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "id": 16,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "Operações Lentas > 150ms — filtro via unwrap nos logs",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{service_name=\"ranking-api\", exporter=\"OTLP\"} | json | attributes_duration_ms > 150",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }

  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["devops", "logs", "loki", "logql", "opentelemetry"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "DevOps — Saúde da Aplicação via Logs",
  "uid": "devops-logs-001",
  "version": 1
}
