{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "description": "",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "title": "Ranking API — Latência por Percentil",
  "uid": "ranking-api-latency",
  "description": "Latência p50/p95/p99 por endpoint, taxa de erros e link para traces no Tempo.",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "tags": ["opentelemetry", "ranking-api", "latency"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Latência por Percentil — todos os endpoints",
      "description": "p50 = mediana (50% das requisições são mais rápidas que isso)\np95 = 95% das requisições estão abaixo desse valor\np99 = 99% estão abaixo — captura o pior caso comum, excluindo outliers extremos",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/p99/" },
            "properties": [
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/p95/" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/p50/" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(request_duration_ms_bucket{service_name=\"ranking-api\"}[5m])) by (le))",
          "legendFormat": "p99 — todos",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(request_duration_ms_bucket{service_name=\"ranking-api\"}[5m])) by (le))",
          "legendFormat": "p95 — todos",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(request_duration_ms_bucket{service_name=\"ranking-api\"}[5m])) by (le))",
          "legendFormat": "p50 — todos",
          "refId": "C"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latência p99 por endpoint",
      "description": "Mostra qual endpoint está causando o pico do p99. Use este gráfico para decidir onde investigar traces no Tempo.",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" },
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(request_duration_ms_bucket{service_name=\"ranking-api\"}[5m])) by (le, endpoint))",
          "legendFormat": "p99 — {{endpoint}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p99 atual (últimos 5 min)",
      "description": "Valor pontual do p99 agora. Se estiver acima de 200ms, abra o Tempo e filtre: { resource.service.name = \"ranking-api\" && duration > 200ms }",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "orange", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          },
          "mappings": []
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(request_duration_ms_bucket{service_name=\"ranking-api\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Taxa de erros por endpoint (req/s)",
      "description": "Correlacione com os picos de latência. Erros frequentemente causam p99 alto quando há retries ou timeouts.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum(rate(api_errors_total{service_name=\"ranking-api\"}[5m])) by (endpoint, reason)",
          "legendFormat": "{{endpoint}} — {{reason}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput — requisições por segundo por endpoint",
      "description": "Volume de tráfego. Use para diferenciar: p99 alto com volume baixo pode ser cold start; com volume alto pode ser saturação.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" },
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"ranking-api\"}[5m])) by (http_route)",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
